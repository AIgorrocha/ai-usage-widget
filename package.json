{
  "name": "ai-usage",
  "version": "1.0.0",
  "private": true,
  "description": "Widget flutuante para Windows: consumo semanal de Claude Code, Codex, Grok Build e Kimi na mesma tela, com aviso de sobra ou estouro do plano",
  "author": "Igor Rocha",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "preparar": "electron --version",
    "test": "node --test",
    "icons": "node tools/make-icons.js",
    "autostart:on": "electron tools/autostart-cli.js --on",
    "autostart:off": "electron tools/autostart-cli.js --off",
    "autostart:status": "electron tools/autostart-cli.js --status",
    "empacotar": "node tools/pack.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "br.com.igorrocha.ai-usage",
    "productName": "AI Usage",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "lib/**/*",
      "assets/**/*",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "artifactName": "AI-Usage-Setup-${version}.${ext}"
    }
  }
}
